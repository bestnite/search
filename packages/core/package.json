{
  "name": "@nite07/search-core",
  "version": "0.2.4",
  "description": "Provider-agnostic multi-backend search engine: backend catalog, adapters, transport and honest failure reporting. No DSH dependency.",
  "license": "MIT",
  "author": "nite07",
  "repository": {
    "type": "git",
    "url": "git+https://git.nite07.com/nite/search.git",
    "directory": "packages/core"
  },
  "homepage": "https://git.nite07.com/nite/search/src/branch/main/packages/core",
  "bugs": {
    "url": "https://git.nite07.com/nite/search/issues"
  },
  "keywords": [
    "search",
    "web-search",
    "multi-backend",
    "mcp",
    "dsh"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./static": {
      "types": "./dist/static.d.ts",
      "import": "./dist/static.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@types/node": "^22.10.2",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@mixmark-io/domino": "^2.2.0",
    "@modelcontextprotocol/client": "2.4.0",
    "patchright-core": "1.64.3",
    "re2js": "^2.10.0",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^8.12.4"
  }
}
