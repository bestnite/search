{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noUncheckedIndexedAccess": true, "esModuleInterop": true, "resolveJsonModule": true,
    "jsx": "react", "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node", "react"],
    "skipLibCheck": true, "noEmit": true
  },
  "include": ["src", "test"]
}
