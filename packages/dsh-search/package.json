{
  "name": "@nite07/dsh-search",
  "version": "0.1.16",
  "description": "Explicit-mode multi-backend search with transparent costs and complete Web settings for DSH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://git.nite07.com/nite/search.git",
    "directory": "packages/dsh-search"
  },
  "homepage": "https://git.nite07.com/nite/search/src/branch/main/packages/dsh-search",
  "bugs": {
    "url": "https://git.nite07.com/nite/search/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "web-search",
    "search",
    "cordis",
    "llm"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "README.zh.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nite07/search-core": "0.2.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-config-editor": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-web": "*",
    "@deepseek-ai/schemastery": "*",
    "zod": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-group": "1.1.0",
    "@deepseek-ai/cordis-plugin-include": "1.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.4",
    "@deepseek-ai/dsh-config-editor": "0.2.2-rc.4",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.4",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.4",
    "@deepseek-ai/dsh-launch-environment": "0.2.2-rc.4",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.4",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.4",
    "@deepseek-ai/dsh-web": "0.2.2-rc.4",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "zod": "4.6.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
