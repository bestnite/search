# Copy to .env beside compose.yaml, then edit. Compose reads it for variable interpolation, and the
# container receives every value listed here through its environment.
#
#   cp env.example .env && chmod 600 .env
#
# .env is not committed; this file is the only record of what the deployment sets.

# This one file configures the shared browser: any backend that needs a real browser attaches to it.

# --- Network -------------------------------------------------------------------------------------

# Address the published ports bind to. 127.0.0.1 keeps them local; use a LAN or tailnet address when
# another machine must reach the endpoint, and never a public one.
BROWSER_BIND_ADDR=127.0.0.1

# Host port for the Playwright endpoint. 3000 is a common collision (anything already bound there
# wins), so this is easy to move.
BROWSER_ENDPOINT_PORT=3000

# Host port for noVNC, the page holding the window a person signs in through.
BROWSER_VNC_PORT=6080

# --- Window --------------------------------------------------------------------------------------

# What the sign-in window opens at. Leave empty for a blank page and navigate in the window.
BROWSER_START_URL=about:blank

# --- Secrets -------------------------------------------------------------------------------------

# VNC password, at most eight characters because that is the protocol's limit. Required as soon as
# the VNC port is reachable from anywhere but loopback: this surface has no other access control.
BROWSER_VNC_PASSWORD=

# Endpoint token. Leave empty to generate one on first start; it is then kept beside the session and
# printed by the proxy at every start.
BROWSER_WS_TOKEN=
