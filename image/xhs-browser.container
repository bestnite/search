# Quadlet for the Xiaohongshu browser. Install into ~/.config/containers/systemd/,
# then: systemctl --user daemon-reload && systemctl --user start xhs-browser
#
# Build the image first:  podman build -t xhs-playwright ~/dev/search-core/image
# The profile volume holds the login and the endpoint token.
[Unit]
Description=Xiaohongshu browser for search-core (Playwright endpoint, VNC login)
After=network-online.target

[Container]
Image=localhost/xhs-playwright:latest
ContainerName=xhs-browser

# Playwright endpoint (token required) and the noVNC surface used to sign in.
# Replace 127.0.0.1 with a reachable address when the browser must be used from another machine.
PublishPort=100.64.0.10:3030:3000
PublishPort=100.64.0.10:6080:6080

# A host directory keeps the session where the search core can read it.
Volume=%h/.config/dsh-search/xhs:/profile:Z
ShmSize=1g

Environment=XHS_WS_PATH=/xhs
# Leave these empty to generate values on first start: the token lands in the profile volume.
Environment=XHS_WS_TOKEN=
# Set a password before exposing 6080 beyond loopback.
# Secrets live outside the repository: this file is not committed with a password in it.
EnvironmentFile=%h/.config/dsh-search/xhs/vnc.env

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
