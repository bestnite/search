{
  "name": "@nite07/search-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Shared search engine, DSH plugin and MCP server workspace",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/dsh-search",
    "packages/websearch-mcp"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "build": "npm run build -w @nite07/search-core && npm run build -w @nite07/dsh-search && npm run build -w @nite07/websearch-mcp",
    "typecheck": "npm run build -w @nite07/search-core && npm run typecheck --workspaces",
    "test": "npm run build -w @nite07/search-core && npm test --workspaces",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:workspace",
    "verify:workspace": "node scripts/verify-workspace.mjs",
    "pack": "npm run build && node scripts/pack.mjs",
    "prepare": "node scripts/prepare-git-install.mjs"
  },
  "bin": {
    "websearch-mcp": "packages/websearch-mcp/dist/main.js"
  },
  "files": [
    "packages/websearch-mcp/dist",
    "packages/websearch-mcp/package.json",
    "packages/core/dist",
    "packages/core/package.json",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "dependencies": {
    "@nite07/search-core": "0.2.0",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.2.0",
    "@modelcontextprotocol/client": "2.4.0"
  },
  "bundleDependencies": [
    "@nite07/search-core",
    "@modelcontextprotocol/server",
    "@modelcontextprotocol/core",
    "zod",
    "@modelcontextprotocol/client"
  ]
}
